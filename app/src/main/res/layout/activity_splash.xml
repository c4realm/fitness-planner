<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Orange top accent bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:background="@color/orange_primary"
        android:layout_gravity="top" />

    <!-- Outer ring -->
    <View
        android:layout_width="380dp"
        android:layout_height="380dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_ring_outer"
        android:alpha="0.12" />

    <!-- Middle ring -->
    <View
        android:layout_width="270dp"
        android:layout_height="270dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_ring_outer"
        android:alpha="0.20" />

    <!-- Inner ring -->
    <View
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_ring_outer"
        android:alpha="0.35" />

    <!-- Center content -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Logo tile -->
        <FrameLayout
            android:id="@+id/logoTile"
            android:layout_width="@dimen/logo_tile_size"
            android:layout_height="@dimen/logo_tile_size"
            android:background="@drawable/bg_logo_tile"
            android:layout_marginBottom="@dimen/space_lg">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_logo_hexagon"
                android:contentDescription="Arcade Fitness logo" />
        </FrameLayout>

        <!-- App name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Arcade"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:letterSpacing="-0.02"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fitness"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/orange_primary"
            android:letterSpacing="-0.02"
            android:gravity="center" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tagline"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:letterSpacing="0.2"
            android:textAllCaps="true"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center" />

    </LinearLayout>

    <!-- Bottom: loading bar + text -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Loading progress bar -->
        <ProgressBar
            android:id="@+id/loadingBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="180dp"
            android:layout_height="3dp"
            android:progressDrawable="@drawable/bg_progress_bar"
            android:max="100"
            android:progress="65"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:textSize="10sp"
            android:textColor="@color/text_disabled"
            android:letterSpacing="0.1"
            android:textAllCaps="true"
            android:layout_marginTop="@dimen/space_sm" />

    </LinearLayout>

</FrameLayout>
